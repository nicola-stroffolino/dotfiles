"custom/gpuinfo": {
    "exec": "~/.config/waybar/scripts/gpuinfo.sh",
    "return-type": "json",
    "format": "{}",
    "rotate": ${r_deg
    },
    "interval": 5, // once every 5 seconds
    "tooltip": true,
    "max-length": 1000,
    "on-click": "~/.config/waybar/scripts/gpuinfo.sh --toggle",
},
"custom/gpuinfo#nvidia": {
    "exec": "~/.config/waybar/scripts/gpuinfo.sh --use nvidia ",
    "return-type": "json",
    "format": "{}",
    "rotate": ${r_deg
    },
    "interval": 5, // once every 5 seconds
    "tooltip": true,
    "max-length": 1000,
},
"custom/gpuinfo#amd": {
    "exec": "~/.config/waybar/scripts/gpuinfo.sh --use amd ",
    "return-type": "json",
    "format": "{}",
    "rotate": ${r_deg
    },
    "interval": 5, // once every 5 seconds
    "tooltip": true,
    "max-length": 1000,
},
"custom/gpuinfo#intel": {
    "exec": "~/.config/waybar/scripts/gpuinfo.sh --use intel ",
    "return-type": "json",
    "format": "{}",
    "rotate": ${r_deg
    },
    "interval": 5, // once every 5 seconds
    "tooltip": true,
    "max-length": 1000,
},